{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cribstone Admin",
  "version": "0.1.0",
  "identifier": "com.cribstone.admin",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cribstone Admin",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Cribstone Coffee admin dashboard",
    "longDescription": "Staff dashboard for managing menu, orders, inventory, and analytics at Cribstone Coffee."
  }
}
