# Postgres connection used locally (docker compose uses db host internally)
DATABASE_URL=postgres://groundwork:groundwork@localhost:5432/groundwork

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# API
PORT=4000
# Public base URL of the API (used by cookies)
API_PUBLIC_URL=http://localhost:4000

# Frontend origin allowed for CORS / cookies
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
