# Postgres connection used locally (docker compose uses db host internally)
DATABASE_URL=postgres://cribstone:cribstone@localhost:5432/cribstone

# API
PORT=4000
# Public base URL of the API (used by cookies)
API_PUBLIC_URL=http://localhost:4000

# Frontend origin allowed for CORS / cookies
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ---- Customer auth (Better Auth) ----
# Secret for signing customer session cookies (min 16 chars; use a strong random value in prod)
BETTER_AUTH_SECRET=customer-auth-secret-change-me
# Public base URL of the API (must match BETTER_AUTH mount / app origin)
BETTER_AUTH_URL=http://localhost:4000
# Extra comma-separated trusted origins (e.g. deployed web app domain)
BETTER_AUTH_TRUSTED_ORIGINS=

# ---- Social providers (fill in when you create the OAuth apps) ----
# Google: https://console.cloud.google.com -> Google Cloud / APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: https://developer.apple.com -> Certificates, Identifiers & Profiles -> Sign in with Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
